# Runtime
NODE_ENV=development
APP_VERSION=0.1.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://focus_forest:changeme@localhost:5432/focus_forest?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SEC=60
METRICS_RATE_LIMIT_MAX=60
METRICS_RATE_LIMIT_WINDOW_SEC=60
SYNC_RATE_LIMIT_MAX=120
SYNC_RATE_LIMIT_WINDOW_SEC=60

# Argon2id
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# App security and observability
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
IDEMPOTENCY_TTL_SEC=604800
SENTRY_DSN=
